# Python virtualenv
.venv/
__pycache__/
*.pyc

# Native desktop app bundle (regenerate with ./build_app.sh) + local env
build/
.env

# Match data + runtime state (regenerated each session)
match_data.json
match_data.csv
control.json
status.json
recorder.json
# The Eye's runtime state: supervisor view, the runner's own health file, and
# the flag files it uses for liveness and half-time pausing.
vision_runner.json
live_eye_status.json
.live_vision.pid
.live_eye_paused
notes.json
notes_audio/
audio_reviews.json
audio_reviews.jsonl
corrections.json
review_audio/
reports/
recordings/
*.tmp

# Report/artifact exports: keep the directory (and its docs), ignore the
# generated, regenerable bundles inside it.
exports/*
!exports/.gitkeep
!exports/README.md
# The vision page is authored, not generated — it is the shareable form of
# PRODUCT_VISION.md and belongs in version control with it.
!exports/vision.html

# Vision pipeline artifacts. Large regenerables stay ignored; the trained model,
# the annotation zip, and the public dataset are kept IN-REPO so both the desktop
# and the laptop have everything after a pull.
*.pt
!soccer_yolov8m_v1.pt
*.mp4
match_stats*.json
match_data.vision*.json
pitch_calibration.json
runs/
datasets/
soccer_frames*/
annotation_frames/
match_segments/
*.zip
!annotation_frames.zip

# Match library — local DB + managed media store (regenerable / large)
library.db
library/
backups/

# macOS
.DS_Store
notes.json
annotation_frames_360p/
clip.mp4
